{
  "manifest_version": 3,
  "name": "X 计划助手",
  "version": "1.0.0",
  "description": "读取 web.cafe 群友优质 Post 列表，每日随机推荐待关注账号，本地管理关注进度。",
  "permissions": ["storage", "tabs", "scripting", "sidePanel"],
  "host_permissions": ["https://web.cafe/*", "https://new.web.cafe/*", "https://*.web.cafe/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "X 计划助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.cafe/*", "https://new.web.cafe/*", "https://*.web.cafe/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
